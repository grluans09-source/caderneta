# Cabeçalhos para o Cloudflare Pages (e compatíveis). O GitHub Pages ignora este arquivo.
# O celular precisa buscar o sw.js e o HTML sempre atualizados para pegar versões novas.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
